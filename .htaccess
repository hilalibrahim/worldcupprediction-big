# PredictCup - Apache Configuration for XAMPP

# Enable mod_rewrite
<IfModule mod_rewrite.c>
    Options -Indexes
    Options +FollowSymLinks
    
    RewriteEngine On
    
    # For XAMPP, RewriteBase should match the directory path
    # If project is in htdocs/worldcupprediction-big, use:
    RewriteBase /worldcupprediction-big/
    
    # If RewriteBase doesn't work, try without it:
    # RewriteBase /
    
    # Main rewrite rules - handle root path and pages
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Protect sensitive files
<FilesMatch "\.(sql|md|env|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# PHP settings - error reporting for development
php_flag display_errors On
php_value error_reporting E_ALL
